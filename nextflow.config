/*
========================================================================================
    Nextflow Configuration File (Enhanced with Sample IDs)
========================================================================================
*/

// Global default params
params {
    // Input/Output
    genex_fastq           = null
    crispr_fastq          = null
    reference             = null
    feature_reference     = null
    outdir                = './results'
    
    // Sample IDs (NEW - for portability!)
    genex_sample_id       = null
    crispr_sample_id      = null
    
    // Cell Ranger parameters
    cellranger_id         = 'perturbseq_analysis'
    expect_cells          = 5000
    create_bam            = false
    cellranger_path       = 'cellranger'  // Assumes cellranger is in PATH
    
    // Container registry (change to your registry)
    container_registry    = 'docker.io'
    
    // Resource allocation
    max_cpus              = 12
    max_memory            = '15.GB'
    max_time              = '48.h'
    
    // QC parameters
    skip_fastqc           = false
    skip_multiqc          = false
    
    // Pipeline options
    publish_dir_mode      = 'copy'
    
    // Help
    help                  = false
}

// Container configuration
docker {
    enabled = false  // Enable with -profile docker
    runOptions = '-u $(id -u):$(id -g)'
}

singularity {
    enabled = false  // Enable with -profile singularity
    autoMounts = true
}

// Process-specific resource requirements
process {
    // Default resources
    cpus   = { check_max( 4, 'cpus' ) }
    memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    time   = { check_max( 4.h * task.attempt, 'time' ) }
    
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'
    
    // Process-specific resources and containers
    withName: 'FASTQC.*' {
        cpus   = { check_max( 4, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h, 'time' ) }
    }
    
    withName: MULTIQC {
        cpus   = 1
        memory = { check_max( 2.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h, 'time' ) }
    }
    
    withName: CELLRANGER_MULTI {
        cpus   = params.max_cpus
        memory = params.max_memory
        time   = { check_max( 24.h * task.attempt, 'time' ) }
    }
}

// Execution profiles
profiles {
    
    // Standard profile (local execution, no containers)
    standard {
        process.executor = 'local'
    }
    
    // Docker profile with public containers
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        podman.enabled         = false
        
        process {
            withName: 'FASTQC.*' {
                container = 'biocontainers/fastqc:v0.11.9_cv8'
            }
            withName: MULTIQC {
                container = 'quay.io/biocontainers/multiqc:1.14--pyhdfd78af_0'
            }
            withName: CELLRANGER_MULTI {
                // IMPORTANT: You must build your own Cell Ranger container
                // See CONTAINER_GUIDE.md for instructions
                container = "${params.container_registry}/cellranger:10.0.0"
            }
        }
    }
    
    // Singularity profile with public containers
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
        
        process {
            withName: 'FASTQC.*' {
                container = 'https://depot.galaxyproject.org/singularity/fastqc:0.11.9--0'
            }
            withName: MULTIQC {
                container = 'https://depot.galaxyproject.org/singularity/multiqc:1.14--pyhdfd78af_0'
            }
            withName: CELLRANGER_MULTI {
                // You must build your own Cell Ranger Singularity container
                container = 'file:///path/to/cellranger-10.0.0.sif'
            }
        }
    }
    
    // HPC cluster with SLURM
    slurm {
        process {
            executor       = 'slurm'
            queue          = 'normal'
            clusterOptions = null
        }
    }
    
    // HPC cluster with PBS
    pbs {
        process {
            executor       = 'pbs'
            queue          = 'normal'
            clusterOptions = null
        }
    }
    
    // AWS Batch with containers from ECR
    awsbatch {
        process {
            executor = 'awsbatch'
            queue    = 'genomics-job-queue'
            
            withName: 'FASTQC.*' {
                container = "${params.container_registry}/fastqc:0.11.9"
            }
            withName: MULTIQC {
                container = "${params.container_registry}/multiqc:1.14"
            }
            withName: CELLRANGER_MULTI {
                container = "${params.container_registry}/cellranger:10.0.0"
            }
        }
        
        aws {
            region = 'us-east-1'
            batch {
                cliPath = '/home/ec2-user/miniconda/bin/aws'
                volumes = '/tmp'
                maxParallelTransfers = 4
                maxTransferAttempts = 3
            }
        }
    }
    
    // Test profile with minimal resources
    test {
        params {
            max_cpus   = 2
            max_memory = '6.GB'
            max_time   = '2.h'
        }
    }
}

// Export environment variables
env {
    PYTHONNOUSERSITE = 1
}

// Capture exit codes from upstream processes
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Timeline, report and trace
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

// Function to ensure that resource requirements don't go beyond maximum limit
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

// Manifest
manifest {
    name            = 'perturbseq-pipeline'
    author          = 'ddelgadillod'
    homePage        = 'https://github.com/ddelgadillod/Loka_TechChallenge'
    description     = 'Nextflow pipeline for 10x Genomics Perturb-seq data analysis with subworkflows and sample ID support'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version         = '2.1.0'
}