/*
========================================================================================
    Nextflow Configuration File - Hybrid (Local + Docker Support)
========================================================================================
*/

// Global default params
params {
    // Input/Output
    genex_fastq           = null
    crispr_fastq          = null
    reference             = null
    feature_reference     = null
    outdir                = './results'
    
    // Cell Ranger parameters
    cellranger_id         = 'perturbseq_analysis'
    expect_cells          = 5000
    create_bam            = false
    
    // Local installation paths (set to null to use containers)
    cellranger_path       = null  // e.g., '/opt/cellranger-10.0.0/bin/cellranger' or 'cellranger' if in PATH
    fastqc_path           = null  // e.g., 'fastqc' if in PATH or conda
    multiqc_path          = null  // e.g., 'multiqc' if in PATH or conda
    
    // Conda environment (optional - for FastQC/MultiQC)
    conda_env             = null  // e.g., '/path/to/conda/envs/qc-env' or 'qc-env'
    
    // Container registry (for Docker/Singularity profiles)
    container_registry    = 'ddelgadillo' 
    
    // Resource allocation
    max_cpus              = 12
    max_memory            = '15.GB'
    max_time              = '48.h'
    
    // QC parameters
    skip_fastqc           = false
    skip_multiqc          = false
    
    // Pipeline options
    publish_dir_mode      = 'copy'
    
    // Help
    help                  = false
}

// Conda configuration (enabled when using conda profile)
conda {
    enabled = false
    useMamba = false  // Set to true if using mamba instead of conda
    createTimeout = '1 h'
}

// Container configuration
docker {
    enabled = false  // Disabled by default - enable with -profile docker
    runOptions = '-u $(id -u):$(id -g)'
    temp = 'auto'
    fixOwnership = true
}

singularity {
    enabled = false  // Enable with -profile singularity
    autoMounts = true
    runOptions = '--cleanenv'
}

// Process-specific resource requirements
process {
    // Default resources
    cpus   = { check_max( 4, 'cpus' ) }
    memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    time   = { check_max( 4.h * task.attempt, 'time' ) }
    
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'
    
    // Process-specific resources (containers defined in profiles)
    withName: 'QC:FASTQC.*' {
        cpus   = { check_max( 4, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h, 'time' ) }
    }
    
    withName: 'QC:MULTIQC' {
        cpus   = 1
        memory = { check_max( 2.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h, 'time' ) }
    }
    
    withName: '.*CELLRANGER_MULTI' {
        cpus   = params.max_cpus
        memory = params.max_memory
        time   = { check_max( 24.h * task.attempt, 'time' ) }
    }
}

// Execution profiles
profiles {
    
    // ==================== LOCAL EXECUTION PROFILES ====================
    
    // Standard profile - Local installations (no containers)
    standard {
        process.executor = 'local'
        docker.enabled = false
        singularity.enabled = false
        conda.enabled = false
    }
    
    // Local with Conda - Use conda environments for QC tools
    conda {
        conda.enabled = true
        conda.useMamba = false
        
        process {
            withName: 'QC:FASTQC.*' {
                conda = params.conda_env ?: 'bioconda::fastqc=0.11.9'
            }
            withName: 'QC:MULTIQC' {
                conda = params.conda_env ?: 'bioconda::multiqc=1.14'
            }
            // Cell Ranger uses local installation (not available in conda)
        }
    }
    
    // Local with Mamba (faster than conda)
    mamba {
        conda.enabled = true
        conda.useMamba = true
        
        process {
            withName: 'QC:FASTQC.*' {
                conda = params.conda_env ?: 'bioconda::fastqc=0.11.9'
            }
            withName: 'QC:MULTIQC' {
                conda = params.conda_env ?: 'bioconda::multiqc=1.14'
            }
        }
    }
    
    // ==================== CONTAINER PROFILES ====================
    
    // Docker profile - Use Docker containers
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        docker.temp            = 'auto'
        docker.fixOwnership    = true
        singularity.enabled    = false
        podman.enabled         = false
        conda.enabled          = false
        
        process {
            withName: 'QC:FASTQC.*' {
                container = 'biocontainers/fastqc:v0.11.9_cv8'
            }
            withName: 'QC:MULTIQC' {
                container = 'quay.io/biocontainers/multiqc:1.14--pyhdfd78af_0'
            }
            withName: '.*CELLRANGER_MULTI' {
                container = "${params.container_registry}/cellranger:10.0.0"
            }
        }
    }
    
    // Singularity profile - Use Singularity containers (HPC)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = '--cleanenv'
        docker.enabled         = false
        podman.enabled         = false
        conda.enabled          = false
        
        process {
            withName: 'QC:FASTQC.*' {
                container = 'docker://biocontainers/fastqc:v0.11.9_cv8'
            }
            withName: 'QC:MULTIQC' {
                container = 'docker://quay.io/biocontainers/multiqc:1.14--pyhdfd78af_0'
            }
            withName: '.*CELLRANGER_MULTI' {
                container = "docker://${params.container_registry}/cellranger:10.0.0"
            }
        }
    }
    
    // ==================== HPC PROFILES ====================
    
    // HPC cluster with SLURM + local installations
    slurm {
        process {
            executor       = 'slurm'
            queue          = 'normal'
            clusterOptions = null
        }
    }
    
    // HPC cluster with SLURM + Singularity
    slurm_singularity {
        process {
            executor       = 'slurm'
            queue          = 'normal'
            clusterOptions = null
        }
        
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = "$HOME/.singularity_cache"
        }
        
        process {
            withName: 'QC:FASTQC.*' {
                container = 'docker://biocontainers/fastqc:v0.11.9_cv8'
            }
            withName: 'QC:MULTIQC' {
                container = 'docker://quay.io/biocontainers/multiqc:1.14--pyhdfd78af_0'
            }
            withName: '.*CELLRANGER_MULTI' {
                container = "docker://${params.container_registry}/cellranger:10.0.0"
            }
        }
    }
    
    // HPC cluster with PBS
    pbs {
        process {
            executor       = 'pbs'
            queue          = 'normal'
            clusterOptions = null
        }
    }
    
    // ==================== CLOUD PROFILES ====================
    
    // AWS Batch with containers from ECR
    awsbatch {
        process {
            executor = 'awsbatch'
            queue    = 'genomics-job-queue'
            
            withName: 'QC:FASTQC.*' {
                container = "${params.container_registry}/fastqc:0.11.9"
            }
            withName: 'QC:MULTIQC' {
                container = "${params.container_registry}/multiqc:1.14"
            }
            withName: '.*CELLRANGER_MULTI' {
                container = "${params.container_registry}/cellranger:10.0.0"
            }
        }
        
        aws {
            region = 'us-east-1'
            batch {
                cliPath = '/home/ec2-user/miniconda/bin/aws'
                volumes = '/tmp'
                maxParallelTransfers = 4
                maxTransferAttempts = 3
            }
        }
    }
    
    // ==================== TESTING PROFILE ====================
    
    // Test profile with minimal resources
    test {
        params {
            max_cpus   = 2
            max_memory = '6.GB'
            max_time   = '2.h'
        }
    }
}

// Export environment variables
env {
    PYTHONNOUSERSITE = 1
}

// Capture exit codes from upstream processes
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Timeline, report and trace
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

// Function to ensure that resource requirements don't go beyond maximum limit
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

// Manifest
manifest {
    name            = 'perturbseq-pipeline'
    author          = 'Diego A Delgadillo-Duran'
    homePage        = 'https://github.com/yourusername/perturbseq-pipeline'
    description     = 'Nextflow pipeline for 10x Genomics Perturb-seq data analysis - supports local, conda, and container execution'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version         = '2.0.0'
}